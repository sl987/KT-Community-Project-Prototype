# Public base URL (sitemap, robots, OG images). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where "Report an error" links go: a mailto: address or a form URL (§11).
# Leave unset to point to the About page.
NEXT_PUBLIC_REPORT_ERROR_URL=

# Data pipeline (GitHub Actions secrets; only needed to run `npm run sync` locally).
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
