# Public base URL (sitemap, robots, OG images). No trailing slash.
# On Vercel, defaults to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where "Report an error" links go: a mailto: address or a form URL (§11).
# Leave unset to use mailto:ildem.gur@mail.utoronto.ca (lib/site.ts).
NEXT_PUBLIC_REPORT_ERROR_URL=

# Data pipeline (GitHub Actions secrets; only needed to run `npm run sync` locally).
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=

# The PAHSSION LinkedIn community page (Connect page + program pages).
# Leave unset to show "coming soon".
NEXT_PUBLIC_LINKEDIN_COMMUNITY_URL=

# Anonymous click tracking (server-only: never prefix these with NEXT_PUBLIC_).
# Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Supabase service role (secret) key. Bypasses RLS, so keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Password for /admin/stats.
STATS_PASSWORD=
